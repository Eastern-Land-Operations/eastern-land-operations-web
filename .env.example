# Resend API Key
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address to receive all form submissions
CONTACT_EMAIL=contact@easternlandoperations.com

# The "From" address for outgoing emails (must be a verified Resend domain)
# For testing you can use: onboarding@resend.dev
FROM_EMAIL=notifications@easternlandoperations.com

# Optional: Site URL (used in email footers and metadata)
NEXT_PUBLIC_SITE_URL=https://easternlandoperations.com
